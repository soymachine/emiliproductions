# Copia este fichero como .env.local y rellena con los datos de tu proyecto Firebase
# (Consola Firebase → Configuración del proyecto → Tus apps → App web → Configuración del SDK).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Pon 1 para usar los emuladores locales (npm run emulators)
NEXT_PUBLIC_USE_EMULATORS=
