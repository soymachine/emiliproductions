{
  "name": "emili-presupuestos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-emili",
