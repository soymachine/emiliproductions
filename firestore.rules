rules_version = '2';

// Solo estas cuentas pueden leer o escribir datos.
// Para dar acceso a otra persona: créala en Firebase Authentication y añade aquí su email en minúsculas.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['xuse.moya@gmail.com', 'soymachine@gmail.com'];
    }

    match /settings/{id} { allow read, write: if isOwner(); }
    match /clients/{id} { allow read, write: if isOwner(); }
    match /articleTypes/{id} { allow read, write: if isOwner(); }
    match /quotes/{id} { allow read, write: if isOwner(); }
    match /counters/{id} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // Las facturas emitidas no se pueden borrar ni modificar: solo su estado de cobro.
    match /invoices/{id} {
      allow read, create: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt']);
      allow delete: if false;
    }
  }
}
