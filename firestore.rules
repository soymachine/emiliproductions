rules_version = '2';

// isOwner(): acceso completo. isViewer(): solo consulta (presupuestos y facturas, sin poder cambiar nada,
// y sin acceso a la ficha de clientes: los documentos ya llevan su copia del cliente).
// Para dar acceso a otra persona: créala en Firebase Authentication y añade su email en minúsculas
// en la lista que corresponda. Los de consulta también van en src/lib/access.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['xuse.moya@gmail.com', 'soymachine@gmail.com'];
    }

    function isViewer() {
      return request.auth != null
        && request.auth.token.email in ['emiliomateotorreblanca@gmail.com'];
    }

    function canRead() {
      return isOwner() || isViewer();
    }

    match /settings/{id} { allow read: if canRead(); allow write: if isOwner(); }
    match /clients/{id} { allow read, write: if isOwner(); }
    match /articleTypes/{id} { allow read: if canRead(); allow write: if isOwner(); }
    match /quotes/{id} { allow read: if canRead(); allow write: if isOwner(); }
    match /counters/{id} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // Las facturas emitidas no se pueden borrar ni modificar: solo se registran sus cobros y anotaciones.
    match /invoices/{id} {
      allow read: if canRead();
      allow create: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'payments', 'paidCents', 'annotations']);
      allow delete: if false;
    }
  }
}
